# App
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
TZ_DISPLAY=Asia/Dubai
# Database
DATABASE_URL=postgresql://user:password@localhost:5432/altabeer
# Auth (server-side only; never expose to the client)
SESSION_SECRET=change-me-min-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14
# Odoo (dedicated integration user, least privilege)
ODOO_BASE_URL=
ODOO_DB=
ODOO_API_KEY=
ODOO_API_STYLE=json2   # json2 | jsonrpc
ODOO_WEBHOOK_SECRET=
# OCR provider (not yet selected)
OCR_PROVIDER=
OCR_API_KEY=
# File storage (private bucket / local dir in dev)
STORAGE_DRIVER=local
STORAGE_PATH=./.storage
# Notifications (optional)
SMTP_URL=
WHATSAPP_API_TOKEN=
# Odoo product IDs used for expense categories (required for expense submission)
ODOO_PRODUCT_FUEL=
ODOO_PRODUCT_PARKING=
# Development only: ODOO_MODE=mock uses an in-memory Odoo (refused in production)
ODOO_MODE=
# Optional Odoo domain limiting hr.employee to drivers, e.g. [["department_id.name","=","Drivers"]]
ODOO_DRIVER_DOMAIN=
# OCR: google-vision (needs OCR_API_KEY) or mock (development only; treats the file as plain text)
OCR_MIN_CONFIDENCE=0.85
# Fine workflow
REMINDER_DAYS=7,3,1
ESCALATE_L2_DAYS=3
JOB_SECRET=change-me-24+chars
SMTP_URL=
EMAIL_FROM=
# Development only: NOTIFY_MODE=mock records emails in memory instead of sending
NOTIFY_MODE=
# Odoo -> app webhook (HMAC-SHA256 of "<timestamp>.<body>" in X-Signature, unix seconds in X-Timestamp)
SYNC_MAX_ATTEMPTS=8
